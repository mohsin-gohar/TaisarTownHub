# ====================================================================
# DEPRECATED / NOT AUTHORITATIVE — DO NOT BUILD THIS FILE
# ====================================================================
# This legacy multi-stage file predates the current production architecture.
# It bundles nginx+supervisord into the API image, used PHP 8.2, installed the
# SQLite CLI and generated APP_KEY AT BUILD TIME (a secret baked into the
# image). None of that matches docker-compose.yml or CI.
#
# Authoritative production images:
#   backend/Dockerfile.prod   (PHP-FPM, context ./backend)
#   frontend/Dockerfile.prod  (static SPA, context ./frontend)
#   docker-compose.yml        (+ .env with runtime secrets)
# Kept only as historical reference; never use it for a deployment.
# ====================================================================
FROM php:8.2-fpm-alpine AS backend-base

RUN apk add --no-cache \
    nginx \
    supervisor \
    git \
    curl \
    libpng-dev \
    libxml2-dev \
    zip \
    unzip \
    mysql-client \
    rabbitmq-c-dev \
    && docker-php-ext-install pdo pdo_mysql bcmath gd xml

WORKDIR /var/www/html

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

COPY backend/ .

RUN composer install --no-dev --optimize-autoloader

# APP_KEY must be supplied at runtime — never generate/bake secrets in an image.

# Optimize for production
RUN php artisan config:cache \
    && php artisan route:cache \
    && php artisan view:cache

EXPOSE 8080

COPY docker/backend/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/backend/nginx.conf /etc/nginx/nginx.conf

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]

# ====================================================================
# Multi-stage build for frontend (Nginx-served production build)
# ====================================================================
FROM node:24-alpine AS frontend-builder

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build

FROM nginx:alpine
COPY --from=frontend-builder /app/dist /usr/share/nginx/html
COPY docker/frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
