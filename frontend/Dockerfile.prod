# TaisarTownHub Frontend - Production Dockerfile (compose-compatible)
# Builds from ./frontend context. VITE_* args are baked at build time.

FROM node:24-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=/api
ARG VITE_APP_MODE=production
ARG VITE_SENTRY_DSN=
ARG VITE_GA_MEASUREMENT_ID=
ARG VITE_LOGROCKET_APP_ID=
ARG VITE_STRIPE_PUBLIC_KEY=
ARG VITE_GOOGLE_OAUTH_ENABLED=false
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_APP_MODE=$VITE_APP_MODE
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_GA_MEASUREMENT_ID=$VITE_GA_MEASUREMENT_ID
ENV VITE_LOGROCKET_APP_ID=$VITE_LOGROCKET_APP_ID
ENV VITE_STRIPE_PUBLIC_KEY=$VITE_STRIPE_PUBLIC_KEY
ENV VITE_GOOGLE_OAUTH_ENABLED=$VITE_GOOGLE_OAUTH_ENABLED

RUN npm run build

FROM nginx:1.30.8-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
