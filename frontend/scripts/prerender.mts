/**
 * Build-time meta prerender for the public SPA routes.
 *
 * A client-rendered SPA ships one HTML shell for every URL, so link unfurlers
 * (WhatsApp, Facebook, LinkedIn, Slack) and non-JS crawlers only ever saw the
 * homepage's title and description. This script runs after `vite build` and
 * emits one HTML file per public route with that route's title, description,
 * canonical, Open Graph tags and JSON-LD already baked in.
 *
 * It also regenerates sitemap.xml from the same source of truth
 * (src/config/seo.ts), so the sitemap can never drift from the <head> tags.
 *
 * Written as `.mts` so `tsx` can import the TypeScript SEO module directly.
 */
import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import path from 'node:path';
import {
  SEO_HEAD_END,
  SEO_HEAD_START,
  SEO_ROUTES,
  SITE_URL,
  renderSeoHead,
} from '../src/config/seo';

const root = process.cwd();
const distDir = path.join(root, 'dist');
const shellPath = path.join(distDir, 'index.html');
const sitemapPath = path.join(distDir, 'sitemap.xml');

if (!existsSync(shellPath)) {
  console.error('[prerender] dist/index.html not found — run `vite build` first.');
  process.exit(1);
}

const shell = readFileSync(shellPath, 'utf8');
const start = shell.indexOf(SEO_HEAD_START);
const end = shell.indexOf(SEO_HEAD_END);

if (start === -1 || end === -1 || end < start) {
  console.error(
    `[prerender] index.html is missing the ${SEO_HEAD_START} / ${SEO_HEAD_END} markers.`,
  );
  process.exit(1);
}

/** Inject a route's head block into the shell, replacing the marked region. */
const withHead = (route: (typeof SEO_ROUTES)[number]): string =>
  shell.slice(0, start + SEO_HEAD_START.length) +
  '\n    ' +
  renderSeoHead(route) +
  '\n    ' +
  shell.slice(end);

// Detail routes share a path with their listing page and are only meaningful
// with a ?property= / ?project= query string, so the listing page owns the file.
const pageRoutes = SEO_ROUTES.filter((r) => !r.requiresQuery);
const written: string[] = [];

for (const route of pageRoutes) {
  const html = withHead(route);

  if (route.path === '/') {
    writeFileSync(shellPath, html, 'utf8');
    written.push('index.html');
    continue;
  }

  const segment = route.path.replace(/^\//, '');

  // `<segment>.html` is what Vercel's cleanUrls resolves; `<segment>/index.html`
  // covers hosts (and `vite preview`) that prefer a directory index.
  writeFileSync(path.join(distDir, `${segment}.html`), html, 'utf8');
  const dir = path.join(distDir, segment);
  mkdirSync(dir, { recursive: true });
  writeFileSync(path.join(dir, 'index.html'), html, 'utf8');
  written.push(`${segment}.html`, `${segment}/index.html`);
}

// --- sitemap.xml -----------------------------------------------------------
const lastmod = new Date().toISOString().slice(0, 10);
const urls = SEO_ROUTES.filter((r) => r.inSitemap)
  .map(
    (r) => `  <url>
    <loc>${SITE_URL}${r.path === '/' ? '/' : r.path}</loc>
    <lastmod>${lastmod}</lastmod>
    <changefreq>${r.changefreq || 'monthly'}</changefreq>
    <priority>${(r.priority ?? 0.5).toFixed(1)}</priority>
  </url>`,
  )
  .join('\n');

writeFileSync(
  sitemapPath,
  `<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/prerender.mts from src/config/seo.ts — do not edit by hand.
     Back-office routes (/admin, /admin-login) are excluded and disallowed in robots.txt.
     Property/project detail pages are excluded: they are dynamic, discovered via internal links. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
${urls}
</urlset>
`,
  'utf8',
);

// --- robots.txt ------------------------------------------------------------
// Generated (not the static public/robots.txt) so the Sitemap line always
// matches SITE_URL from src/config/seo.ts instead of drifting per environment.
const disallowed = SEO_ROUTES.filter((r) => !r.indexable && !r.requiresQuery)
  .map((r) => `Disallow: ${r.path}`)
  .join('\n');

writeFileSync(
  path.join(distDir, 'robots.txt'),
  `# TaisarTownHub — public site crawler rules
# Generated by scripts/prerender.mts from src/config/seo.ts — do not edit by hand.
User-agent: *
Allow: /
${disallowed}

Sitemap: ${SITE_URL}/sitemap.xml
`,
  'utf8',
);

console.log(`[prerender] robots.txt: ${disallowed.split('\n').length} disallow rule(s).`);
console.log(`[prerender] wrote ${written.length} page(s):`);
for (const f of written) console.log(`  - ${f}`);
console.log(`[prerender] sitemap.xml: ${SEO_ROUTES.filter((r) => r.inSitemap).length} URL(s).`);
