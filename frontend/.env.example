# TaisarTownHub environment configuration
# Copy to .env.local and fill in. All VITE_ vars are inlined into the client bundle.

# API base URL WITHOUT a trailing slash.
# Local: http://127.0.0.1:8080/api — Production: https://api.taisartownhub.com/api
VITE_API_URL=http://127.0.0.1:8080/api

# Build mode: public | demo | production
VITE_APP_MODE=public

# Show Google sign-in only when backend OAuth credentials are configured.
VITE_GOOGLE_OAUTH_ENABLED=false

# Presenter PIN for demo role switching. Leave empty to disable the PIN gate.
VITE_DEMO_PIN=

# Legacy fallback (still honoured): VITE_DEMO_MODE=true

# --- Firebase (optional, Phase 8) ---
# Leave blank to keep the demo on localStorage (default).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Stripe (public key only — never secret keys) ---
VITE_STRIPE_PUBLIC_KEY=

# --- Analytics & Monitoring ---
VITE_SENTRY_DSN=
VITE_GA_MEASUREMENT_ID=
VITE_LOGROCKET_APP_ID=

# --- SaaS / Subscription ---
VITE_PAYMENT_PROVIDER=stripe
VITE_SUBSCRIPTION_API_URL=

# --- Agency Tenant ---
VITE_DEFAULT_AGENCY_ID=

# --- Canonical site origin (SEO: canonical, OG, JSON-LD, sitemap) ---
# No trailing slash. Production: https://taisartownhub.com
VITE_SITE_URL=http://localhost:3000