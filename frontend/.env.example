# TaisarTownHub environment configuration
# Copy to .env.local and fill in. All VITE_ vars are inlined into the client bundle.

# Build mode: public | demo | production
VITE_APP_MODE=public

# Presenter PIN for demo mode (default 4545)
VITE_DEMO_PIN=4545

# Legacy fallback (still honoured): VITE_DEMO_MODE=true

# --- Firebase (optional, Phase 8) ---
# Leave blank to keep the demo on localStorage (default).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=