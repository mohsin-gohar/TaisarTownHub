# TaisarTownHub Backend - Production Dockerfile (compose-compatible)
# Builds from ./backend context. Runtime config/secrets are provided via env;
# APP_KEY must be supplied at runtime (never generated/baked during image build).
#
# Runtime is PHP-FPM behind the nginx gateway. `php artisan serve` is a
# development server and must never be the production runtime.

FROM php:8.3-fpm-alpine

RUN apk add --no-cache \
    icu-dev \
    libzip-dev \
    libpng-dev \
    libxml2-dev \
    oniguruma-dev \
    curl \
    mysql-client \
    && docker-php-ext-install pdo pdo_mysql bcmath intl zip gd opcache

# Compose runs Laravel with CACHE_STORE=redis, SESSION_DRIVER=redis and
# QUEUE_CONNECTION=redis. Without a Redis PHP driver, `Cache::get()` throws
# at runtime and the container healthcheck can NEVER become healthy (it
# stayed unhealthy for ~3 minutes in Docker CI run #9). Install phpredis;
# no composer dependency or REDIS_CLIENT override is needed.
RUN apk add --no-cache --virtual .phpize-deps $PHPIZE_DEPS linux-headers \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .phpize-deps

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Dependencies first (layer cached).
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

# Application code + autoloader.
COPY . ./
RUN composer dump-autoload --optimize \
    && mkdir -p storage/app/private/documents storage/app/private/quarantine storage/app/public storage/logs \
       storage/framework/cache storage/framework/sessions storage/framework/views bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

# PHP runtime limits for real uploads (defaults are 2M/8M and would reject
# document and map uploads before Laravel ever sees them).
COPY docker/php-prod.ini /usr/local/etc/php/conf.d/zz-production.ini

# Runtime entrypoint (validates APP_KEY, caches config/routes).
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm", "-F"]
