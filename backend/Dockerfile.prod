# TaisarTownHub Backend - Production Dockerfile (compose-compatible)
# Builds from ./backend context. Runtime config/secrets are provided via env;
# APP_KEY must be supplied at runtime (never generated/baked during image build).

FROM php:8.3-cli-alpine

RUN apk add --no-cache \
    icu-dev \
    libzip-dev \
    libpng-dev \
    libxml2-dev \
    oniguruma-dev \
    curl \
    mysql-client \
    && docker-php-ext-install pdo pdo_mysql bcmath intl zip gd opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Dependencies first (layer cached).
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

# Application code + autoloader.
COPY . .
RUN composer dump-autoload --optimize \
    && mkdir -p storage/app/private/documents storage/app/public storage/logs \
       storage/framework/cache storage/framework/sessions storage/framework/views bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

# Runtime entrypoint (validates APP_KEY, caches config/routes, runs migrations).
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER www-data

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8080"]
