# =============================================================================
# TaisarTownHub API — environment template
# =============================================================================
# Copy to .env, then:
#   php artisan key:generate
# This file defaults to PRODUCTION values. For local development override:
#   APP_ENV=local
#   APP_URL=http://127.0.0.1:8080
#   CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
#   SESSION_SECURE_COOKIE=false
#   LOG_LEVEL=debug
# =============================================================================

APP_NAME="TaisarTownHub API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.taisartownhub.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logging (never ship debug logs to production) ---------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taisartownhub
DB_USERNAME=
DB_PASSWORD=

# --- Sessions & cookies ------------------------------------------------------
# Set true whenever the site is served over HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Sanctum API tokens ------------------------------------------------------
# Domestic frontend origin only; never include localhost in production.
SANCTUM_STATEFUL_DOMAINS=taisartownhub.com
SANCTUM_TOKEN_PREFIX=tth_

# --- CORS (comma-separated exact origins, no wildcard) -----------------------
CORS_ALLOWED_ORIGINS=https://taisartownhub.com

# --- Queues, cache & filesystems --------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@taisartownhub.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Optional S3 storage (leave blank to use the local private disks) --------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Frontend build-time name only ------------------------------------------
VITE_APP_NAME="${APP_NAME}"
