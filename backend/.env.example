# =============================================================================
# TaisarTownHub API — environment template
# Copy to .env, then:
#   php artisan key:generate
# This file defaults to PRODUCTION values. For local development override:
#   APP_ENV=local
#   APP_URL=http://127.0.0.1:8080
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173
#   SESSION_SECURE_COOKIE=true
#   LOG_LEVEL=debug
# =============================================================================

APP_NAME="TaisarTownHub API"
APP_ENV=production
APP_KEY=
# Previous Laravel APP_KEY values during controlled rotation (comma-separated).
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://api.taisartownhub.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logging (never ship debug logs to production) ---------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taisartownhub
DB_USERNAME=taisartownhub_app
DB_PASSWORD=

# --- Sanctum API tokens ------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=taisartownhub.com
SANCTUM_TOKEN_PREFIX=tth_

# --- CORS (exact origins, no wildcard) ---------------------------------------
# Production: your real HTTPS origin(s) only.
# Local dev / Playwright (port 4173): http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173
CORS_ALLOWED_ORIGINS=https://taisartownhub.com

# --- SPA origin for auth mail links (password reset / email verification) ----
FRONTEND_URL=https://taisartownhub.com

# --- Queues, cache & filesystems --------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@taisartownhub.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Payment Gateways --------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# --- Monitoring ------------------------------------------------------------
SENTRY_DSN=
LOGROCKET_APP_ID=

# --- Agency Domains ----------------------------------------------------------
AGENCY_DOMAIN=taisartownhub.com

# --- Frontend build-time name only ------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# --- Optional S3 storage (leave blank to use the local private disks) --------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Multi-Tenant SaaS Configuration -----------------------------------------
TENANT_ISOLATION_MODE=database
DEFAULT_TENANT_ID=taisar-town-hub
TENANT_KEY_HEADER=X-Agency-Id

# --- Rate Limiting ----------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5
REGISTER_RATE_LIMIT_PER_MINUTE=3

# --- Malware scanning (production: enable with a real ClamAV daemon/socket) ---
# Fail closed when scanning is unavailable to prevent unscanned uploads in prod.
MALWARE_SCAN_ENABLED=true
MALWARE_SCANNER=clamav
CLAMSCAN_COMMAND=clamscan
CLAMD_SOCKET=127.0.0.1:3310
MALWARE_SCAN_FAIL_CLOSED=true
MALWARE_SCAN_LOG_SKIPPED=true

# --- Secure Document & Media Vault -------------------------------------------
# AES-256-GCM at-rest encryption for every byte on the private disks. The
# vault key is derived from APP_KEY (rotate APP_KEY, then run
# `php artisan vault:encrypt` to re-write stored files with the new key).
FILE_VAULT_ENCRYPTION=true
# Days rejected/quarantined uploads stay on the isolated quarantine disk
# before `vault:purge-quarantine` (scheduled daily) erases them.
VAULT_QUARANTINE_RETENTION_DAYS=30

# --- Session cookies (secure on production HTTPS) ----------------------------
SESSION_SECURE_COOKIE=true

# --- Trusted Proxies (IP spoofing prevention) --------------------------------
# Set to your real load-balancer/CDN IPs in production. Defaults to 127.0.0.1
# (safe when no proxy is in front of the app).
TRUSTED_PROXIES=127.0.0.1

# Google OAuth (optional; required for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.taisartownhub.com/api/auth/google/callback
# For local dev, override FRONTEND_URL in backend/.env (not .env.example)
