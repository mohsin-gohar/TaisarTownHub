# TaisarTownHub environment variables
# IMPORTANT: Vite exposes ONLY variables prefixed with VITE_ to the client bundle.
# Never put real secrets in VITE_ variables — they ship to every visitor.

# Build mode: 'public' (marketing site, no demo code) | 'demo' (client presentation, PIN-gated demo) | 'production' (locked-down ERP for a real operator).
VITE_APP_MODE="demo"

# Fallback for older docs/tools: 'true' behaves like demo mode, 'false' like public mode.
# Prefer VITE_APP_MODE. This is read only when VITE_APP_MODE is missing.
VITE_DEMO_MODE="true"

# Presenter PIN required before the instant demo sign-in grid appears (demo builds only).
# NOTE: a client-side PIN is only a speed bump, not real security. Demo deployments must use
# Vercel password protection and contain fictional data only.
VITE_DEMO_PIN="4545"

# Backend: 'local' (default, browser localStorage/IndexedDB demo) | 'firebase' (Phase 8)
VITE_BACKEND="local"
